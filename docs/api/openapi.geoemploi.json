                              "profileId": "cmtrovqoy0003hhsdidp3sl30"
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "pagination": { "page": 1, "limit": 10, "total": 2, "totalPages": 1 }
                }
              }
            }
          }
        }
      }
    },
    "/api/applications/{id}": {
      "put": {
        "tags": ["Applications"],
        "summary": "Accept or reject a candidate",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "status": "ACCEPTED" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application updated",
            "content": {
              "application/json": {
                "example": {
                  "id": "cmtrozkk40003hhw76lpy5is3",
                  "jobId": "cmtrozih70001hhw7vx8r31np",
                  "seekerId": "cmtrovqot0001hhsd9en76mad",
                  "status": "ACCEPTED",
                  "createdAt": "2026-09-07T20:27:34.996Z",
                  "updatedAt": "2026-09-07T20:27:34.996Z"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Applications"],
        "summary": "Delete an application",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Application deleted" }
        }
      }
    },
    "/api/geocode": {
      "get": {
        "tags": ["System"],
        "summary": "Geocode a location query",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "example": "Paris 11e" },
          { "name": "lat", "in": "query", "schema": { "type": "number" } },
          { "name": "lon", "in": "query", "schema": { "type": "number" } }
        ],
        "responses": {
          "200": {
            "description": "Geocoding result",
            "content": {
              "application/json": {
                "example": {
                  "features": [
                    {
                      "geometry": { "coordinates": [2.381844, 48.860162] },
                      "properties": { "label": "Paris 11e" }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing parameters",
            "content": {
              "application/json": {
                "example": { "error": "Indiquez une adresse ou des coordonnées" }
              }
            }
          }
        }
      }
    },
    "/api/seeker/profile": {
      "get": {
        "tags": ["Seeker"],
        "summary": "Get seeker profile",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Seeker profile",
            "content": {
              "application/json": {
                "example": {
                  "id": "cmtrovqoy0003hhsdidp3sl30",
                  "userId": "cmtrovqot0001hhsd9en76mad",
                  "bio": "Développeur full-stack en recherche active",
                  "availability": "FULL_TIME",
                  "availableFrom": "2026-09-15",
                  "updatedAt": "2026-09-07T20:24:36.323Z",
                  "skills": [
                    { "id": "cmtrovqp40004hhsdqcd6xcat", "name": "TypeScript", "profileId": "cmtrovqoy0003hhsdidp3sl30" },
                    { "id": "cmtrovqp40005hhsdxyhoim1f", "name": "Next.js", "profileId": "cmtrovqoy0003hhsdidp3sl30" } 
                  ],
                  "experiences": [
                    {
                      "id": "cmtrovqpg0008hhsdonxbv1i3",
                      "title": "Développeur Frontend",
                      "company": "NovaLabs",
                      "startDate": "2024-01-01",
                      "endDate": "2025-06-30",
                      "description": "Conception et maintenance d’applications web",
                      "profileId": "cmtrovqoy0003hhsdidp3sl30"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Seeker"],
        "summary": "Update seeker profile",
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "bio": "Développeur full-stack en recherche active",
                "availability": "FULL_TIME",
                "availableFrom": "2026-09-15"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
