                            { "id": "cmtrovqp40004hhsdqcd6xcat", "name": "TypeScript", "profileId": "cmtrovqoy0003hhsdidp3sl30" }
                          ],
                          "experiences": [
                            {
                              "id": "cmtrovqpg0008hhsdonxbv1i3",
                              "title": "Développeur Frontend",
